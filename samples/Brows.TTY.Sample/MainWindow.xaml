<Window x:Class="Brows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tty="http://schemas.brows.app/winfx/2026/xaml/presentation"
        Title="Brows Terminal" Width="1000" Height="640" Background="#1E1E1E">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#252526" Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Restart" Padding="12,4" Click="RestartClick" />
        <TextBlock Foreground="#DDDDDD" VerticalAlignment="Center"
                   Text="Ghostty terminal · Ctrl+Shift+C copy · Ctrl+Shift+V paste · Shift+drag select" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#CCCCCC" Margin="12,4"
               Text="Starting shell…" />
    <tty:Terminal x:Name="Console" Margin="8" FontSize="16"
                  ProcessExited="ProcessExited" Failed="TerminalFailed" />
  </DockPanel>
</Window>
